APP_NAME="RutX Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sesión server-side (sprint/2): driver database; en cookie solo el identificador.
# SESSION_ENCRYPT=true cifra el payload; SESSION_SECURE_COOKIE=true solo en producción (HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Frontera conceptual hacia el Hub/Relay central (rutx.quest/api/v1).
# Laravel NUNCA se conecta a un Sincronizador por IP, DNS individual ni :5047;
# el Hub resuelve la instalación por identidad. NO conectar un Hub real aún:
# el contrato Relay no está implementado, por eso no se definen endpoints
# nuevos y los stubs (RUTX_HUB_STUBS_ENABLED=true en local/testing) devuelven
# la forma exacta de los DTO sin HTTP. Nunca versionar CLIENT_SECRET.
RUTX_HUB_BASE_URL=https://rutx.quest/api/v1
RUTX_HUB_TIMEOUT=30
RUTX_HUB_CONNECT_TIMEOUT=10
RUTX_HUB_AUTH_URL=https://rutx.quest/api/v1/auth
RUTX_HUB_CLIENT_ID=rutx-web-client
RUTX_HUB_CLIENT_SECRET=
RUTX_HUB_VERIFY_TLS=true
RUTX_HUB_STUBS_ENABLED=false
RUTX_HUB_TOKEN_TTL=300

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
